#!/bin/sh
# ADR-0001: every commit carries `Task:`/`Agent:`/`Verified:`. Provenance for humans and CI.
msg=$(cat "$1")
case "$msg" in
  Merge* | Revert* ) exit 0 ;;
esac

missing=""
for t in Task Agent Verified; do
  printf '%s\n' "$msg" | grep -q "^$t: " || missing="$missing $t"
done

if [ -n "$missing" ]; then
  echo "commit-msg: missing trailer(s):$missing" >&2
  echo "  Task: #<issue> or bootstrap" >&2
  echo "  Agent: <harness and model that wrote it>" >&2
  echo "  Verified: <the command you ran, with its result>" >&2
  exit 1
fi

# The Agent trailer must name the model that actually ran. An author cannot be trusted to
# remember it — the first one of these was written from assumption and got it wrong.
# Convention: `Agent: <harness> / <model>[, notes]`. The model may be human-readable, so every
# token of it must appear inside $PI_MODEL, and at least one must be substantive. That admits
# "Qwen 3.8 Flash Next" and refuses an invented family. Skipped when $PI_MODEL is unset
# (a human shell or CI), where there is nothing to compare against.
if [ -n "${PI_MODEL:-}" ]; then
  agent=$(printf '%s\n' "$msg" | grep '^Agent: ' | head -1)
  model=$(printf '%s' "${agent##*/}" | sed -E 's/[,;(].*//' | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' ' ')
  norm=$(printf ' %s ' "$PI_MODEL" | tr 'A-Z' 'a-z' | tr -c 'a-z0-9' ' ')
  substantive=0
  for tok in $model; do
    case "$norm" in
      *"$tok"*) [ "${#tok}" -ge 4 ] && substantive=1 ;;
      *) echo "commit-msg: Agent: names '$tok', which is not in \$PI_MODEL ($PI_MODEL)" >&2
         echo "  form: Agent: <harness> / <model>[, notes]" >&2
         exit 1 ;;
    esac
  done
  if [ "$substantive" -eq 0 ]; then
    echo "commit-msg: Agent: must name the model, not just noise ($PI_MODEL)" >&2
    exit 1
  fi
fi
