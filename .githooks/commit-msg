#!/bin/sh
# ADR-0001: every commit carries `Task:`/`Agent:`/`Verified:`. Provenance for humans and CI.
msg=$(cat "$1")
case "$msg" in
  Merge* | Revert* ) exit 0 ;;
esac

missing=""
for t in Task Agent Verified; do
  printf '%s\n' "$msg" | grep -q "^$t: " || missing="$missing $t"
done

if [ -n "$missing" ]; then
  echo "commit-msg: missing trailer(s):$missing" >&2
  echo "  Task: #<issue> or bootstrap" >&2
  echo "  Agent: <harness and model that wrote it>" >&2
  echo "  Verified: <the command you ran, with its result>" >&2
  exit 1
fi

# The Agent trailer must name the model that actually ran. An author cannot be trusted to
# remember it — the first one of these was written from assumption and got it wrong.
if [ -n "${PI_MODEL:-}" ]; then
  if ! printf '%s\n' "$msg" | grep "^Agent: " | grep -qF -- "$PI_MODEL"; then
    echo "commit-msg: Agent: must name \$PI_MODEL = $PI_MODEL" >&2
    exit 1
  fi
fi
