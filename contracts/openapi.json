{
  "openapi": "3.1.0",
  "info": {
    "title": "transcodarr API",
    "version": "0.0.0"
  },
  "paths": {
    "/jobs": {
      "get": {
        "operationId": "list_jobs",
        "responses": {
          "200": {
            "description": "jobs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Job"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "create_job",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewJob"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{id}": {
      "delete": {
        "operationId": "cancel_job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "cancelled"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "JobState": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "done",
          "failed"
        ]
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "path",
          "state",
          "progress",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "path": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/JobState"
          },
          "progress": {
            "type": "number",
            "format": "float"
          },
          "fail_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NewJob": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "preset": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
